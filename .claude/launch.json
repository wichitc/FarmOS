{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ifcviewer-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "ifcviewer-backend",
      "runtimeExecutable": "backend\\.venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000", "--reload", "--reload-dir", "backend"],
      "port": 8000,
      "url": "http://localhost:8000"
    }
  ]
}
