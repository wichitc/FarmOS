DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ifcviewer
CORS_ORIGINS=http://localhost:5173
# DATA_DIR is optional - defaults to backend/data/models (resolved relative to
# this file's location, not the process's working directory). Only set this
# if you want uploaded IFC models stored somewhere else - use an absolute path.
# DATA_DIR=/absolute/path/to/storage
